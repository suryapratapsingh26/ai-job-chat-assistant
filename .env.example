# Scraper defaults target up to 1,800 current public listings.
SCRAPER_MAX_JOBS=1800
SCRAPER_REQUEST_DELAY=0.5
SCRAPER_TIMEOUT=20
SCRAPER_RETRIES=3
SCRAPER_MAX_PAGES=100

# Optional comma-separated public Greenhouse board slugs to supplement Arbeitnow.
# Example: GREENHOUSE_BOARDS=company-one,company-two
GREENHOUSE_BOARDS=

# Optional paths/logging
# JOBS_OUTPUT=data/jobs.json
# LOG_LEVEL=INFO
